---
import { getCollection } from "astro:content";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import { siteConfig } from "../../config";
import "../../styles/global.css";

const entries = (
  await getCollection(
    "notes",
    ({ data }) => data.visibility === "public" && data.status !== "draft",
  )
).sort(
  (a, b) =>
    new Date(b.data.publishDate).getTime() -
    new Date(a.data.publishDate).getTime(),
);
---

<html lang="en" style={`--site-accent: ${siteConfig.accentColor}`}>
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={`Engineering notes by ${siteConfig.name}`}
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} - Writing`}
      href={new URL("rss.xml", Astro.site)}
    />
    <title>Notes - {siteConfig.name}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={`Notes - ${siteConfig.name}`} />
    <meta
      property="og:description"
      content={`Engineering notes by ${siteConfig.name}`}
    />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={new URL("og-image.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Notes - ${siteConfig.name}`} />
    <meta
      name="twitter:description"
      content={`Engineering notes by ${siteConfig.name}`}
    />
    <meta name="twitter:image" content={new URL("og-image.png", Astro.site)} />
  </head>
  <body>
    <Header />
    <main class="max-w-3xl mx-auto px-6 pt-28 pb-16 sm:pt-32 sm:pb-24">
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-50"
      >
        Notes
      </h1>
      <p class="font-plex-sans mt-2 text-gray-600 dark:text-gray-400">
        Short, focused technical write-ups, separate from the full case studies
        in{" "}
        <a href="/projects" class="underline underline-offset-4"> Projects </a>
        .
      </p>
      {
        entries.length === 0 && (
          <p class="mt-6 text-gray-600 dark:text-gray-400">
            No notes published yet.
          </p>
        )
      }
      <ul class="mt-8 space-y-6">
        {
          entries.map((entry) => (
            <li>
              <a
                href={`/notes/${entry.data.slug}`}
                class="group block surface-card rounded-2xl p-5 sm:p-6 transition-transform duration-300 hover:-translate-y-1"
              >
                <p class="text-xs text-gray-600 dark:text-gray-400 uppercase tracking-wide">
                  {new Date(entry.data.publishDate).toLocaleDateString(
                    "en-US",
                    { year: "numeric", month: "long", day: "numeric" },
                  )}
                </p>
                <h2 class="mt-1 text-xl font-semibold text-gray-900 dark:text-gray-50 group-hover:underline">
                  {entry.data.title}
                </h2>
                <p class="mt-1 text-gray-600 dark:text-gray-400">
                  {entry.data.summary}
                </p>
                {entry.data.tags && entry.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {entry.data.tags.map((tag) => (
                      <span class="surface-card px-2.5 py-1 rounded-full text-xs font-medium text-gray-700 dark:text-gray-300">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <Footer />
  </body>
</html>
