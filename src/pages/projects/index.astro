---
import { getCollection } from "astro:content";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config";
import "../../styles/global.css";

const entries = await getCollection(
  "projects",
  ({ data }) => data.visibility === "public" && data.status !== "draft",
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`Case studies by ${siteConfig.name}`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} - Projects`}
      href={new URL("rss.xml", Astro.site)}
    />
    <title>Projects - {siteConfig.name}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={`Projects - ${siteConfig.name}`} />
    <meta
      property="og:description"
      content={`Case studies by ${siteConfig.name}`}
    />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`Projects - ${siteConfig.name}`} />
    <meta
      name="twitter:description"
      content={`Case studies by ${siteConfig.name}`}
    />
  </head>
  <body>
    <Header />
    <main class="max-w-3xl mx-auto px-6 pt-28 pb-16 sm:pt-32 sm:pb-24">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">Projects</h1>
      {
        entries.length === 0 && (
          <p class="mt-6 text-gray-600">No case studies published yet.</p>
        )
      }
      <ul class="mt-8 space-y-8">
        {
          entries.map((entry) => (
            <li>
              <a href={`/projects/${entry.data.slug}`} class="group block">
                <h2 class="text-xl font-semibold text-gray-900 group-hover:underline">
                  {entry.data.title}
                </h2>
                <p class="mt-1 text-gray-600">{entry.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <Footer />
  </body>
</html>
