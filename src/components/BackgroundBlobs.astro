---
// Ambient blurred gradient blobs behind the glass cards. Fixed to the
// viewport so they show through consistently regardless of scroll
// position or page length.
---

<div
  class="fixed inset-0 -z-20 overflow-hidden pointer-events-none"
  aria-hidden="true"
>
  <div
    class="gradient-blob w-[500px] h-[500px] -top-40 -left-40 bg-blue-400/15 dark:bg-blue-500/10"
  >
  </div>
  <div
    class="gradient-blob w-[600px] h-[600px] top-1/3 -right-52 bg-violet-400/12 dark:bg-violet-500/8"
  >
  </div>
  <div
    class="gradient-blob w-[450px] h-[450px] bottom-0 left-1/4 bg-indigo-300/12 dark:bg-indigo-600/8"
  >
  </div>
</div>
