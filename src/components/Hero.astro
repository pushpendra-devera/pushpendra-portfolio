---
import { createAvatar } from "@dicebear/core";
import { notionists } from "@dicebear/collection";
import { siteConfig } from "../config";

// Deterministic abstract avatar (MIT/CC0-licensed generator, no real photo
// or likeness) generated at build time from the site owner's name as seed.
const avatarSvg = createAvatar(notionists, {
  seed: siteConfig.name,
  backgroundColor: ["transparent"],
}).toString();

// "4.6 years of experience" is the figure stated in the resume summary.
const yearsExperience = "4.6+";
const currentCompany = siteConfig.experience?.[0]?.company;
const coreSkills = siteConfig.skills.slice(0, 4);
---

<div id="hero" class="relative dot-grid py-24 sm:py-32">
  <div class="w-full mx-auto px-6 sm:px-12 md:px-16 max-w-5xl">
    <div
      class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-start"
    >
      <!-- copy -->
      <div class="animate-fade-in">
        <p
          class="text-xs sm:text-sm font-semibold uppercase tracking-[0.14em]"
          style="color: var(--site-accent)"
        >
          {siteConfig.title}
        </p>

        <h1
          class="mt-4 text-pretty text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-gray-900 dark:text-gray-50"
        >
          {siteConfig.name}
        </h1>

        <p
          class="font-plex-sans mt-5 text-pretty text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-400 max-w-xl"
        >
          I build production mobile apps for Android and iOS &mdash; {
            yearsExperience
          } years in React Native and TypeScript. Currently shipping <span
            class="text-gray-900 dark:text-gray-100 font-semibold"
            >Dallal</span
          >, a bilingual real-estate marketplace live in Kuwait with 75+ screens,
          in-app calling, and full App Store &amp; Play release pipelines.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
          {
            siteConfig.resumeUrl && (
              <a
                href={siteConfig.resumeUrl}
                download
                class="btn-accent inline-flex items-center gap-2 rounded px-5 py-3 text-sm font-semibold transition-opacity"
              >
                Download resume
              </a>
            )
          }
          <a
            href="/projects"
            class="inline-flex items-center gap-2 rounded px-5 py-3 text-sm font-medium border border-gray-300 dark:border-gray-700 text-gray-800 dark:text-gray-200 transition-colors hover:border-[var(--site-accent)] hover:text-[var(--site-accent)]"
          >
            View projects
          </a>

          <div
            class="hidden sm:block w-px h-6 bg-gray-300 dark:bg-gray-700 mx-1"
          >
          </div>

          {
            siteConfig.social?.email && (
              <a
                href={`mailto:${siteConfig.social.email}`}
                aria-label="Email"
                class="inline-flex items-center justify-center w-9 h-9 rounded text-gray-600 dark:text-gray-400 transition-colors hover:text-[var(--site-accent)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                  <path d="M3 7l9 6l9 -6" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="inline-flex items-center justify-center w-9 h-9 rounded text-gray-600 dark:text-gray-400 transition-colors hover:text-[var(--site-accent)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.github && (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="inline-flex items-center justify-center w-9 h-9 rounded text-gray-600 dark:text-gray-400 transition-colors hover:text-[var(--site-accent)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                </svg>
              </a>
            )
          }
        </div>
      </div>

      <!-- facts panel -->
      <div
        class="surface-card animate-fade-in animation-delay-200 rounded-xl p-6 flex flex-col gap-5"
      >
        <div class="flex items-center gap-3">
          <div
            class="w-12 h-12 rounded-lg overflow-hidden flex-none bg-gray-100 dark:bg-gray-800"
          >
            <Fragment set:html={avatarSvg} />
          </div>
          <div>
            <p class="font-semibold text-sm text-gray-900 dark:text-gray-50">
              {siteConfig.name}
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-500">
              {siteConfig.title}
            </p>
          </div>
        </div>

        <div class="h-px bg-gray-200 dark:bg-gray-800"></div>

        <dl class="flex flex-col gap-3">
          <div class="flex items-baseline justify-between">
            <dt
              class="text-[11px] uppercase tracking-wide text-gray-500 dark:text-gray-500"
            >
              Experience
            </dt>
            <dd class="text-sm font-semibold text-gray-900 dark:text-gray-100">
              {yearsExperience} yrs
            </dd>
          </div>
          <div class="flex items-baseline justify-between">
            <dt
              class="text-[11px] uppercase tracking-wide text-gray-500 dark:text-gray-500"
            >
              Platforms
            </dt>
            <dd class="text-sm font-semibold text-gray-900 dark:text-gray-100">
              Android &amp; iOS
            </dd>
          </div>
          {
            currentCompany && (
              <div class="flex items-baseline justify-between">
                <dt class="text-[11px] uppercase tracking-wide text-gray-500 dark:text-gray-500">
                  Current
                </dt>
                <dd class="text-sm font-semibold text-gray-900 dark:text-gray-100">
                  {currentCompany}
                </dd>
              </div>
            )
          }
        </dl>

        <div class="h-px bg-gray-200 dark:bg-gray-800"></div>

        <div class="flex flex-wrap gap-1.5">
          {
            coreSkills.map((skill) => (
              <span class="chip-neutral text-[11px] px-2 py-1 rounded">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
